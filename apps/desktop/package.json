{
  "name": "chatlens-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "利明智耀.Chatlens · 让沟通照见下一步",
  "author": "利明智耀",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node electron/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "pack:mac": "npm run build && electron-builder --mac zip dmg --arm64",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.chatlens.desktop",
    "productName": "利明智耀.Chatlens",
    "asar": true,
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../../dist/worker",
        "to": "worker"
      },
      {
        "from": "../../fixtures",
        "to": "fixtures",
        "filter": [
          "*.jsonl",
          "*.csv"
        ]
      },
      {
        "from": "../../docs/compatibility.json",
        "to": "compatibility.json"
      },
      {
        "from": "../../scripts/native",
        "to": "native",
        "filter": [
          "**/*",
          "!*.swift"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "zip",
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "利明智耀.Chatlens-${version}-${arch}.${ext}"
  }
}
